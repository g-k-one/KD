{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kurwadrop-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4317",
        "--host",
        "127.0.0.1"
      ],
      "port": 4317,
      "autoPort": false
    },
    {
      "name": "kurwadrop-dev-2",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "4327",
        "--host",
        "127.0.0.1"
      ],
      "port": 4327,
      "autoPort": false
    },
    {
      "name": "kurwadrop-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".output/server/index.mjs"
      ],
      "env": {
        "PORT": "4319"
      },
      "port": 4319,
      "autoPort": false
    },
    {
      "name": "kurwadrop-artifact",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4320",
        "--directory",
        "artifact"
      ],
      "port": 4320,
      "autoPort": false
    },
    {
      "name": "kurwadrop-pages",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-pages.mjs",
        "4321"
      ],
      "port": 4321,
      "url": "http://127.0.0.1:4321",
      "autoPort": false
    }
  ]
}